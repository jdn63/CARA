{
  "metadata": {
    "description": "County-level baseline data for vector-borne disease risk assessment in Wisconsin",
    "version": "1.0.0",
    "last_updated": "2026-07-16",
    "sources": [
      "Wisconsin DHS Lyme Disease Surveillance Reports (2018-2023)",
      "CDC ArboNET West Nile Virus Surveillance (2018-2023)",
      "Wisconsin DHS Tick-Borne Disease Summary Reports",
      "USDA Forest Service FIA (Forest Inventory and Analysis) design-based forest cover, EVALID 552501 (WISCONSIN 2025 area evaluation)",
      "U.S. Census Bureau ACS 5-Year Estimates - Rural/Urban Classification"
    ],
    "diseases_covered": [
      "Lyme disease (Borrelia burgdorferi)",
      "Anaplasmosis (Anaplasma phagocytophilum)",
      "Ehrlichiosis (Ehrlichia species)",
      "West Nile Virus (WNV)"
    ],
    "case_rate_tiers": {
      "very_high": "Annual incidence >100 per 100,000 population",
      "high": "Annual incidence 50-100 per 100,000 population",
      "moderate": "Annual incidence 20-50 per 100,000 population",
      "low": "Annual incidence 5-20 per 100,000 population",
      "minimal": "Annual incidence <5 per 100,000 population"
    },
    "notes": "Wisconsin consistently ranks in the top 5 nationally for Lyme disease incidence. The northwestern and north-central counties have the highest tick-borne disease rates. Climate warming is expanding tick and mosquito habitat northward and extending active seasons.",
    "provenance_caveat": "Forest-cover values are now real FIA design-based estimates (see forest_cover_provenance). Deer-density scores remain static v1 seed values: informed by WI DNR deer population estimates but the exact binning thresholds were not documented at authoring time and WI DNR does not publish per-county overwinter density in a queryable API form (only Deer Management Zone/unit boundaries are served via ArcGIS). Treat deer-density as a CARA-curated estimate pending a re-derivable source.",
    "forest_cover_provenance": {
      "source": "USDA Forest Service FIADB (Forest Inventory and Analysis)",
      "evalid": "552501",
      "eval_description": "WISCONSIN 2025: 2019-2025: CURRENT AREA, CURRENT VOLUME",
      "method": "Design-based area estimate: forest_cover_pct = accessible forest land (COND_STATUS_CD=1) / total land (COND_STATUS_CD in 1,2), each condition expanded by CONDPROP_UNADJ * ADJ_FACTOR (SUBP/MACR by PROP_BASIS) * EXPNS from POP_STRATUM.",
      "datamart": "https://apps.fs.usda.gov/fia/datamart/CSV/",
      "fetched": "2026-07-16",
      "coverage": "72 of 72 counties"
    }
  },
